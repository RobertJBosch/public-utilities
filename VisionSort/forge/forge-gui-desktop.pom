<?xml version="1.0" encoding="UTF-8"?>
<!-- Describes Forge's released desktop jar (forge-gui-desktop-<version>-jar-with-dependencies.jar)
     for the local Maven repository. The jar's own embedded pom names a parent that isn't published,
     so it can't be used. See README.md, "Building". -->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>forge</groupId>
  <artifactId>forge-gui-desktop-jar-with-dependencies</artifactId>
  <version>2.0.16</version>
  <packaging>jar</packaging>
</project>
